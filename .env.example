# Configuration reference only. The engine reads process environment; it does not auto-load .env files.
ENGINE_DATA_DIR=.engine
ENGINE_ARTIFACT_DIR=.engine/artifacts
ENGINE_PORT=4318
ENGINE_MAX_JOBS=1
# Only set when a browser frontend needs access. No wildcard origins.
ENGINE_ALLOWED_ORIGINS=http://127.0.0.1:5173
# ENGINE_TOKEN: optional secret of at least 32 characters. Omit to generate a fresh token at startup.
FIXTURE_DATA_DIR=.engine/standalone-fixture
AI_ENABLED=false
# AI_ENDPOINT, AI_MODEL, AI_API_KEY: optional analysis gateway configuration; no defaults or live calls are required.
# PLAYWRIGHT_BROWSERS_PATH: optional path to an installed or bundled Chromium distribution.
