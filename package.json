{
  "name": "adversarial-application-testing-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/cli/server.js",
    "fixture": "node dist/fixtures/cli.js",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "demo": "npm run build && node dist/cli/demo.js",
    "api:spec": "npm run build && node dist/cli/spec.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
