{
  "name": "adversarial-application-testing-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "npm run build:api && node scripts/local-app.mjs --dev",
    "start": "node scripts/local-app.mjs",
    "start:api": "node dist/cli/server.js",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "fixture": "node dist/fixtures/cli.js",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run build:api && vitest run tests",
    "test:web": "npm run test --workspace apps/web",
    "test:browser": "npm run test:e2e --workspace apps/web",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build:api && vitest run tests/integration",
    "test:e2e": "npm run build:api && vitest run tests/e2e",
    "demo": "npm run build:api && node dist/cli/demo.js",
    "api:spec": "npm run build:api && node dist/cli/spec.js",
    "desktop:dev": "node scripts/desktop.mjs --dev",
    "desktop:build": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
